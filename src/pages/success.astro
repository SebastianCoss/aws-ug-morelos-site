---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="¡Registro exitoso!" description="Te has registrado en AWS UG Morelos.">
  <div class="min-h-[80vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <div class="mb-6 relative inline-block">
        <div class="absolute inset-0 bg-[#6B3FA0] opacity-20 blur-2xl rounded-full scale-110"></div>
        <img src="/assets/logo.png" alt="AWS UG Morelos" class="relative w-24 h-24 object-contain mx-auto" />
      </div>

      <div class="text-5xl mb-4">🎉</div>
      <h1 class="text-3xl font-bold text-white mb-3">¡Bienvenido a la comunidad!</h1>
      <p class="text-slate-400 mb-2">
        Tu registro en <strong class="text-white">AWS UG Morelos</strong> fue recibido exitosamente.
      </p>
      <p class="text-slate-400 mb-8">
        Pronto recibirás un correo con los próximos eventos y cómo conectarte con el grupo.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/blog" class="px-6 py-3 rounded-xl bg-[#6B3FA0] hover:bg-purple-600 text-white font-medium transition-colors">
          Explorar el Blog
        </a>
        <a href="/glossary" class="px-6 py-3 rounded-xl border border-[#1E3A6E] text-slate-300 hover:border-[#818CF8] hover:text-white transition-colors">
          Ver Glosario AWS
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
