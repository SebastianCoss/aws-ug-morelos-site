---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="¡Registro exitoso!" description="Te has registrado en AWS UG Morelos.">
  <div class="relative min-h-[88vh] flex items-center justify-center px-4 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 grid-pattern opacity-30 pointer-events-none"></div>
    <div class="absolute inset-0 aurora pointer-events-none"></div>

    <div class="relative z-10 text-center max-w-lg">
      <!-- Icon success -->
      <div class="relative inline-flex mb-8">
        <div class="absolute inset-0 bg-emerald-500 opacity-15 blur-3xl rounded-full scale-150"></div>
        <div class="relative w-20 h-20 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center shadow-2xl shadow-emerald-900/30">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
      </div>

      <h1 class="text-4xl font-bold text-white mb-3">¡Bienvenido a la comunidad!</h1>
      <p class="text-slate-400 text-lg mb-2 leading-relaxed">
        Tu registro en <strong class="text-white">AWS UG Morelos</strong> fue recibido exitosamente.
      </p>
      <p class="text-slate-500 mb-10 leading-relaxed">
        Pronto recibirás un correo con los próximos eventos y cómo conectarte con el grupo.
      </p>

      <!-- Next steps -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-10 text-left">
        {[
          { icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z', label: 'Lee el blog técnico', href: '/blog', color: 'text-cyan-400' },
          { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', label: 'Explora el glosario', href: '/glossary', color: 'text-purple-400' },
          { icon: 'M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125', label: 'Contribuye al blog', href: 'https://github.com/SebastianCoss/aws-ug-morelos-site', color: 'text-emerald-400' },
        ].map(item => (
          <a
            href={item.href}
            class="p-4 rounded-xl bg-[#0D1535] border border-[#1E3A6E] hover:border-[#818CF8]/50 transition-all group card-hover"
          >
            <svg class={`w-5 h-5 mb-2 ${item.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
            </svg>
            <p class="text-white text-sm font-medium group-hover:text-[#818CF8] transition-colors">{item.label}</p>
          </a>
        ))}
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
