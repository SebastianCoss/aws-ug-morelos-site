---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Únete a la Comunidad"
  description="Regístrate en AWS User Group Morelos y sé parte de nuestra comunidad de builders."
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    <div class="text-center mb-10">
      <img src="/assets/logo.png" alt="AWS UG Morelos" class="w-16 h-16 object-contain mx-auto mb-4" />
      <h1 class="text-3xl font-bold text-white mb-3">Únete a AWS UG Morelos</h1>
      <p class="text-slate-400">
        Completa el formulario y te agregaremos a nuestra comunidad. ¡Es completamente gratis!
      </p>
    </div>

    <div class="p-8 rounded-2xl bg-[#0D1535] border border-[#1E3A6E]">
      <!-- Netlify Form -->
      <form
        name="registro-comunidad"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/success/"
        class="space-y-5"
      >
        <!-- Netlify hidden field -->
        <input type="hidden" name="form-name" value="registro-comunidad" />
        <p class="hidden">
          <label>No llenar: <input name="bot-field" autocomplete="off" /></label>
        </p>

        <!-- Nombre -->
        <div>
          <label for="nombre" class="block text-sm font-medium text-slate-300 mb-1.5">
            Nombre completo <span class="text-red-400">*</span>
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            placeholder="Tu nombre completo"
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">
            Correo electrónico <span class="text-red-400">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@correo.com"
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm"
          />
        </div>

        <!-- Ciudad -->
        <div>
          <label for="ciudad" class="block text-sm font-medium text-slate-300 mb-1.5">
            Ciudad <span class="text-red-400">*</span>
          </label>
          <input
            type="text"
            id="ciudad"
            name="ciudad"
            required
            placeholder="Ej. Cuernavaca, Jiutepec, Temixco..."
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm"
          />
        </div>

        <!-- Empresa / Organización -->
        <div>
          <label for="empresa" class="block text-sm font-medium text-slate-300 mb-1.5">
            Empresa u organización <span class="text-slate-500 text-xs">(opcional)</span>
          </label>
          <input
            type="text"
            id="empresa"
            name="empresa"
            placeholder="Donde trabajas o estudias"
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm"
          />
        </div>

        <!-- Experiencia en AWS -->
        <div>
          <label for="experiencia" class="block text-sm font-medium text-slate-300 mb-1.5">
            Nivel de experiencia con AWS <span class="text-red-400">*</span>
          </label>
          <select
            id="experiencia"
            name="experiencia"
            required
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm"
          >
            <option value="" disabled selected class="text-slate-600">Selecciona tu nivel</option>
            <option value="principiante">Principiante — Acabo de empezar</option>
            <option value="intermedio">Intermedio — Uso AWS regularmente</option>
            <option value="avanzado">Avanzado — Tengo certificaciones o exp. profesional</option>
          </select>
        </div>

        <!-- ¿Quieres ser Builder? -->
        <div class="p-4 rounded-xl border border-[#1E3A6E] bg-[#060D24]">
          <p class="text-sm font-medium text-slate-300 mb-3">¿Te gustaría ser Builder de la comunidad?</p>
          <div class="space-y-2">
            {[
              { id: 'builder-hablar', value: 'hablar', label: '🎤 Presentar charlas en meetups' },
              { id: 'builder-blog', value: 'blog', label: '✍️ Escribir posts en el blog' },
              { id: 'builder-workshops', value: 'workshops', label: '🛠️ Dar workshops / talleres' },
              { id: 'builder-organizar', value: 'organizar', label: '🗂️ Ayudar a organizar eventos' },
            ].map(opt => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input
                  type="checkbox"
                  name="builder"
                  value={opt.value}
                  class="w-4 h-4 rounded border-[#1E3A6E] bg-[#0D1535] text-[#6B3FA0] focus:ring-[#6B3FA0] focus:ring-offset-0"
                />
                <span class="text-sm text-slate-400 group-hover:text-slate-300 transition-colors">{opt.label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Mensaje (opcional) -->
        <div>
          <label for="mensaje" class="block text-sm font-medium text-slate-300 mb-1.5">
            ¿Algo que quieras compartir? <span class="text-slate-500 text-xs">(opcional)</span>
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="3"
            placeholder="Cuéntanos sobre ti, qué te interesa aprender, o cualquier pregunta..."
            class="w-full px-4 py-3 rounded-xl bg-[#060D24] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8] transition-colors text-sm resize-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full py-3.5 rounded-xl bg-[#6B3FA0] hover:bg-purple-600 text-white font-semibold text-base transition-all hover:scale-[1.01] active:scale-[0.99]"
          style="box-shadow: 0 0 20px rgba(107,63,160,0.4)"
        >
          Registrarme en la comunidad
        </button>

        <p class="text-xs text-slate-500 text-center">
          Tus datos se usan únicamente para comunicaciones de AWS UG Morelos. Sin spam.
        </p>
      </form>
    </div>
  </div>
</BaseLayout>
