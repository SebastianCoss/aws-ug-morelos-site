---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GlossaryCard from '../../components/glossary/GlossaryCard.astro';

const allTerms = await getCollection('glossary');
const terms = allTerms.sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'));

const sections = [
  { key: 'all',          label: 'Todos',          icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' },
  { key: 'Fundamentos',  label: 'Fundamentos',    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z' },
  { key: 'Comunidad',    label: 'Comunidad',      icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { key: 'Compute',      label: 'Compute',        icon: 'M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18' },
  { key: 'Storage',      label: 'Storage',        icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4' },
  { key: 'Database',     label: 'Database',       icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4' },
  { key: 'Analytics',    label: 'Analítica',      icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { key: 'Security',     label: 'Seguridad',      icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { key: 'Network',      label: 'Redes',          icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9' },
  { key: 'AI/ML',        label: 'IA & ML',        icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2' },
  { key: 'DevOps',       label: 'DevOps',         icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
  { key: 'Roles',        label: 'Roles',          icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { key: 'Optimización', label: 'Optimización',   icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { key: 'Pro Tips',     label: 'Pro Tips',       icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
];
---

<BaseLayout title="Glosario AWS" description="Glosario completo de más de 100 términos y servicios AWS en español, mantenido por la comunidad AWS UG Morelos.">

  <!-- Page header -->
  <div class="relative border-b border-[#1E3A6E] overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-40"></div>
    <div class="absolute inset-0 aurora"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#818CF8]/30 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 py-14 relative z-10">
      <span class="tag bg-[#111F4A] text-[#818CF8] border border-[#1E3A6E] mb-4 block w-fit">Referencia técnica</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Glosario AWS</h1>
      <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
        +100 términos de AWS explicados en español por la comunidad. Desde fundamentos hasta IA, DevOps y más.
      </p>
      <p class="text-slate-600 text-sm mt-3 font-mono">{terms.length} términos · {sections.length - 1} categorías</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 py-10">

    <!-- Search -->
    <div class="mb-6 max-w-xl">
      <div class="relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Buscar término... (ej: Lambda, VPC, IAM)"
          autocomplete="off"
          class="w-full pl-10 pr-10 py-3 rounded-xl bg-[#0D1535] border border-[#1E3A6E] text-white placeholder-slate-600 focus:outline-none focus:border-[#818CF8] focus:ring-1 focus:ring-[#818CF8]/50 transition-all text-sm"
        />
        <button id="clear-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-600 hover:text-slate-400 transition-colors hidden" aria-label="Limpiar búsqueda">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Category tabs -->
    <div class="flex flex-wrap gap-2 mb-8" id="tabs-container" role="tablist" aria-label="Filtrar por categoría">
      {sections.map((s) => (
        <button
          role="tab"
          data-tab={s.key}
          aria-selected={s.key === 'all' ? 'true' : 'false'}
          class={`tab-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all duration-200 ${
            s.key === 'all'
              ? 'bg-[#7C3AED] border-[#7C3AED] text-white shadow-lg shadow-purple-900/30'
              : 'bg-[#0D1535] border-[#1E3A6E] text-slate-500 hover:border-[#818CF8]/50 hover:text-slate-300'
          }`}
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={s.icon}/>
          </svg>
          {s.label}
        </button>
      ))}
    </div>

    <!-- Results count -->
    <p id="results-count" class="text-xs text-slate-600 mb-5 font-mono"></p>

    <!-- Grid -->
    <div id="glossary-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {terms.map(term => (
        <div
          class="glossary-item"
          data-category={term.data.category}
          data-title={term.data.title.toLowerCase()}
          data-description={(term.data.description ?? '').toLowerCase()}
          data-acronym={(term.data.acronym ?? '').toLowerCase()}
        >
          <GlossaryCard term={term} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-20">
      <div class="w-16 h-16 rounded-2xl bg-[#0D1535] border border-[#1E3A6E] flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <p class="text-slate-400 text-lg font-semibold mb-1">Sin resultados</p>
      <p class="text-slate-600 text-sm">
        No encontramos términos para tu búsqueda.
        <button id="clear-search" class="text-[#818CF8] hover:underline ml-1">Limpiar filtros</button>
      </p>
    </div>

    <!-- CTA contribuir -->
    <div class="mt-16 p-7 rounded-2xl border border-[#1E3A6E] bg-gradient-to-br from-[#0D1535] to-[#111F4A] flex flex-col sm:flex-row items-center gap-5">
      <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center">
        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </div>
      <div class="flex-1 text-center sm:text-left">
        <h3 class="text-white font-bold mb-1">¿Falta algún término?</h3>
        <p class="text-slate-400 text-sm">
          Crea un archivo <code class="text-[#818CF8] font-mono text-xs bg-[#060D24] px-1 py-0.5 rounded">.mdx</code> en <code class="text-[#818CF8] font-mono text-xs bg-[#060D24] px-1 py-0.5 rounded">src/content/glossary/</code> y abre un Pull Request.
        </p>
      </div>
      <a
        href="https://github.com/SebastianCoss/aws-ug-morelos-site"
        target="_blank" rel="noopener noreferrer"
        class="flex-shrink-0 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#7C3AED] hover:bg-[#8B5CF6] text-white text-sm font-semibold transition-all duration-200 hover:scale-[1.02] glow-purple whitespace-nowrap"
      >
        Contribuir en GitHub
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </div>

</BaseLayout>

<script>
  const items       = Array.from(document.querySelectorAll<HTMLElement>('.glossary-item'));
  const tabs        = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const emptyState  = document.getElementById('empty-state') as HTMLElement;
  const resultsCount = document.getElementById('results-count') as HTMLElement;
  const clearSearch  = document.getElementById('clear-search');
  const clearBtn     = document.getElementById('clear-btn');

  let activeTab   = 'all';
  let searchQuery = '';

  function filter() {
    let visible = 0;
    items.forEach(item => {
      const cat   = item.dataset.category ?? '';
      const title = item.dataset.title ?? '';
      const desc  = item.dataset.description ?? '';
      const acro  = item.dataset.acronym ?? '';

      const matchTab    = activeTab === 'all' || cat === activeTab;
      const matchSearch = !searchQuery ||
        title.includes(searchQuery) ||
        desc.includes(searchQuery)  ||
        acro.includes(searchQuery);

      const show = matchTab && matchSearch;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    emptyState.classList.toggle('hidden', visible > 0);
    resultsCount.textContent = visible > 0
      ? `${visible} término${visible !== 1 ? 's' : ''} encontrado${visible !== 1 ? 's' : ''}`
      : '';

    // Clear button visibility
    clearBtn?.classList.toggle('hidden', !searchQuery);
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTab = btn.dataset.tab ?? 'all';
      tabs.forEach(b => {
        const isActive = b.dataset.tab === activeTab;
        b.setAttribute('aria-selected', String(isActive));
        b.className = `tab-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all duration-200 ${
          isActive
            ? 'bg-[#7C3AED] border-[#7C3AED] text-white shadow-lg shadow-purple-900/30'
            : 'bg-[#0D1535] border-[#1E3A6E] text-slate-500 hover:border-[#818CF8]/50 hover:text-slate-300'
        }`;
      });
      filter();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filter();
  });

  function clearAll() {
    searchInput.value = '';
    searchQuery = '';
    filter();
  }

  clearSearch?.addEventListener('click', clearAll);
  clearBtn?.addEventListener('click', clearAll);

  filter(); // initial
</script>
