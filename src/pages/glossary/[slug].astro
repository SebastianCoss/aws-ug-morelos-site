---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  return terms.map(term => ({
    params: { slug: term.id },
    props: { term },
  }));
}

const { term } = Astro.props;
const { title, acronym, category, description, useCase, awsLink, relatedServices } = term.data;
const { Content } = await render(term);

// Category color map
const categoryColor: Record<string, string> = {
  Compute: 'bg-orange-900/20 text-orange-400 border-orange-800/40',
  Storage: 'bg-blue-900/20 text-blue-400 border-blue-800/40',
  Network: 'bg-cyan-900/20 text-cyan-400 border-cyan-800/40',
  Database: 'bg-green-900/20 text-green-400 border-green-800/40',
  'AI/ML': 'bg-purple-900/20 text-purple-400 border-purple-800/40',
  Security: 'bg-red-900/20 text-red-400 border-red-800/40',
  DevOps: 'bg-yellow-900/20 text-yellow-400 border-yellow-800/40',
  Analytics: 'bg-teal-900/20 text-teal-400 border-teal-800/40',
  Fundamentos: 'bg-indigo-900/20 text-indigo-400 border-indigo-800/40',
  Comunidad: 'bg-pink-900/20 text-pink-400 border-pink-800/40',
  Roles: 'bg-slate-700/20 text-slate-400 border-slate-600/40',
  'Optimización': 'bg-amber-900/20 text-amber-400 border-amber-800/40',
  'Pro Tips': 'bg-emerald-900/20 text-emerald-400 border-emerald-800/40',
};

const catCls = categoryColor[category] ?? 'bg-slate-700/20 text-slate-400 border-slate-600/40';
---

<BaseLayout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 py-14">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8" aria-label="Navegación">
      <a href="/glossary" class="hover:text-[#818CF8] transition-colors flex items-center gap-1 group">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        Glosario
      </a>
      <svg class="w-3 h-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-slate-400 truncate">{title}</span>
    </nav>

    <!-- Header card -->
    <div class="relative mb-10 p-7 rounded-2xl bg-[#0D1535] border border-[#1E3A6E] overflow-hidden">
      <!-- Subtle accent -->
      <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#7C3AED] via-[#818CF8] to-[#3B82F6]"></div>

      <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
        <div class="flex-1 min-w-0">
          <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">
            {title}
          </h1>
          {acronym && (
            <p class="text-slate-500 font-mono text-sm mt-1">Acrónimo: <span class="text-slate-300">{acronym}</span></p>
          )}
        </div>
        <span class={`tag border ${catCls} flex-shrink-0`}>{category}</span>
      </div>
      <p class="text-slate-300 text-lg leading-relaxed">{description}</p>
    </div>

    <!-- Use Case -->
    <div class="mb-8 p-6 rounded-xl bg-[#0D1535] border border-[#1E3A6E]">
      <h2 class="text-white font-bold mb-3 flex items-center gap-2">
        <div class="w-6 h-6 rounded-lg bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center flex-shrink-0">
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        ¿Cuándo se usa?
      </h2>
      <p class="text-slate-400 leading-relaxed">{useCase}</p>
    </div>

    <!-- Content (MDX) -->
    <div class="prose prose-invert prose-purple max-w-none mb-10
      prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight
      prose-p:text-slate-300 prose-p:leading-relaxed
      prose-a:text-[#818CF8] prose-a:no-underline hover:prose-a:underline
      prose-code:text-[#818CF8] prose-code:bg-[#0D1535] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-[#0D1535] prose-pre:border prose-pre:border-[#1E3A6E] prose-pre:rounded-xl
      prose-blockquote:border-l-[#7C3AED] prose-blockquote:text-slate-400
      prose-strong:text-white prose-li:text-slate-300 prose-li:marker:text-[#818CF8]">
      <Content />
    </div>

    <!-- Related Services -->
    {relatedServices.length > 0 && (
      <div class="mb-8 pt-8 border-t border-[#1E3A6E]">
        <h3 class="text-white font-bold mb-3 flex items-center gap-2 text-sm uppercase tracking-widest text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          Servicios relacionados
        </h3>
        <div class="flex flex-wrap gap-2">
          {relatedServices.map(s => (
            <span class="text-sm px-3 py-1.5 rounded-lg bg-[#111F4A] text-slate-300 border border-[#1E3A6E] font-medium">{s}</span>
          ))}
        </div>
      </div>
    )}

    <!-- AWS Docs link -->
    {awsLink && (
      <div class="mb-8">
        <a
          href={awsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[#1E3A6E] bg-[#0D1535] text-[#818CF8] hover:border-[#818CF8] hover:text-white text-sm font-medium transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Ver documentación oficial de AWS
        </a>
      </div>
    )}

    <!-- Footer nav -->
    <div class="pt-8 border-t border-[#1E3A6E] flex items-center justify-between flex-wrap gap-4">
      <a
        href="/glossary"
        class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Volver al Glosario
      </a>
      <a
        href="/registro"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#7C3AED] hover:bg-[#8B5CF6] text-white text-sm font-semibold transition-all glow-purple"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        Únete a la comunidad
      </a>
    </div>
  </div>
</BaseLayout>
