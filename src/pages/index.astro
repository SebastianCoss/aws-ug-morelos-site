---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/blog/PostCard.astro';
import GlossaryCard from '../components/glossary/GlossaryCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const allTerms = await getCollection('glossary');
const featuredTerms = allTerms.slice(0, 4);
---

<BaseLayout title="Inicio">
  <!-- HERO -->
  <section class="relative overflow-hidden min-h-[90vh] flex items-center">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#6B3FA0] opacity-10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-[#3B82F6] opacity-10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-20 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1 text-center lg:text-left">
          <span class="inline-block text-xs font-semibold uppercase tracking-widest text-[#818CF8] mb-4 px-3 py-1 rounded-full border border-[#1E3A6E] bg-[#0D1535]">
            AWS User Group · Morelos, México
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
            Aprende, comparte y
            <span class="bg-gradient-to-r from-[#818CF8] via-[#6B3FA0] to-[#3B82F6] bg-clip-text text-transparent"> crece en la nube</span>
          </h1>
          <p class="text-lg text-slate-400 mb-8 max-w-lg mx-auto lg:mx-0">
            Somos la comunidad AWS de Morelos. Aquí encontrarás conocimiento real de builders reales: blog técnico, glosario AWS y eventos presenciales.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a href="/registro" class="px-6 py-3 rounded-xl bg-[#6B3FA0] hover:bg-purple-600 text-white font-semibold transition-all hover:scale-105" style="box-shadow: 0 0 20px rgba(107,63,160,0.4)">
              Únete a la comunidad
            </a>
            <a href="/blog" class="px-6 py-3 rounded-xl border border-[#1E3A6E] text-slate-300 hover:border-[#818CF8] hover:text-white transition-colors">
              Ver el Blog
            </a>
          </div>
        </div>

        <div class="flex-shrink-0">
          <div class="relative">
            <div class="absolute inset-0 bg-[#6B3FA0] opacity-20 blur-2xl rounded-full scale-110"></div>
            <img src="/assets/logo.png" alt="AWS UG Morelos" class="relative w-72 h-72 md:w-96 md:h-96 object-contain drop-shadow-2xl" />
          </div>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
        {[
          { value: '100+', label: 'Miembros' },
          { value: '6+', label: 'Eventos' },
          { value: '1 año', label: 'Activos en julio 🎉' },
        ].map(stat => (
          <div class="text-center lg:text-left p-4 rounded-xl bg-[rgba(13,21,53,0.7)] backdrop-blur-md border border-[#1E3A6E]">
            <p class="text-2xl font-extrabold bg-gradient-to-r from-[#818CF8] to-[#3B82F6] bg-clip-text text-transparent">{stat.value}</p>
            <p class="text-xs text-slate-400 mt-1">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-20 bg-[#0D1535]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-4">¿Quiénes somos?</h2>
        <p class="text-slate-400 text-lg leading-relaxed mb-4">
          AWS User Group Morelos es una comunidad independiente de profesionales, estudiantes y entusiastas de la nube en el estado de Morelos, México.
        </p>
        <p class="text-slate-400 leading-relaxed">
          Organizamos meetups, talleres y charlas técnicas. Cualquiera puede contribuir al blog o al glosario y compartir lo que ha aprendido trabajando con AWS.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { icon: '🎤', title: 'Meetups & Eventos', desc: 'Charlas técnicas presenciales y virtuales con expertos de la comunidad y AWS.' },
          { icon: '✍️', title: 'Blog de Miembros', desc: 'Cualquier miembro puede publicar posts técnicos, tutoriales y casos de uso reales.' },
          { icon: '📚', title: 'Glosario AWS', desc: 'Referencia clara y en español de los servicios y conceptos más usados en AWS.' },
        ].map(card => (
          <div class="p-6 rounded-xl bg-[rgba(13,21,53,0.7)] backdrop-blur-md border border-[#1E3A6E] hover:border-[#818CF8] transition-colors">
            <span class="text-3xl mb-4 block">{card.icon}</span>
            <h3 class="text-white font-semibold mb-2">{card.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST BLOG POSTS -->
  {latestPosts.length > 0 && (
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl font-bold text-white">Últimos posts</h2>
            <p class="text-slate-400 mt-1">Conocimiento compartido por la comunidad</p>
          </div>
          <a href="/blog" class="text-sm text-[#818CF8] hover:text-white transition-colors hidden sm:block">Ver todos →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestPosts.map(post => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- GLOSSARY PREVIEW -->
  {featuredTerms.length > 0 && (
    <section class="py-20 bg-[#0D1535]">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl font-bold text-white">Glosario AWS</h2>
            <p class="text-slate-400 mt-1">Términos clave explicados en español</p>
          </div>
          <a href="/glossary" class="text-sm text-[#818CF8] hover:text-white transition-colors hidden sm:block">Ver glosario completo →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {featuredTerms.map(term => <GlossaryCard term={term} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#6B3FA0]/10 to-[#3B82F6]/10 pointer-events-none"></div>
    <div class="max-w-2xl mx-auto px-4 text-center relative z-10">
      <h2 class="text-3xl font-bold text-white mb-4">¿Listo para unirte?</h2>
      <p class="text-slate-400 mb-8">Forma parte de la comunidad AWS más activa de Morelos. Aprende con nosotros, presenta en meetups y contribuye al blog.</p>
      <a href="/registro" class="inline-block px-8 py-4 rounded-xl bg-[#6B3FA0] hover:bg-purple-600 text-white font-semibold text-lg transition-all hover:scale-105" style="box-shadow: 0 0 20px rgba(107,63,160,0.4)">
        Regístrate gratis
      </a>
    </div>
  </section>
</BaseLayout>
