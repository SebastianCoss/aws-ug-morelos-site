---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/blog/PostCard.astro';
import GlossaryCard from '../components/glossary/GlossaryCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const allTerms = await getCollection('glossary');
const featuredTerms = allTerms.slice(0, 4);
---

<BaseLayout title="Inicio" description="AWS User Group Morelos — La comunidad de builders más activa del estado. Blog técnico, glosario AWS y eventos presenciales.">

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden min-h-[92vh] flex items-center">

    <!-- Background layers -->
    <div class="absolute inset-0 grid-pattern opacity-60"></div>
    <div class="absolute inset-0 aurora"></div>
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#818CF8]/40 to-transparent"></div>

    <!-- Floating orbs -->
    <div class="absolute top-1/4 left-1/5 w-[500px] h-[500px] bg-[#7C3AED] opacity-[0.07] rounded-full blur-[80px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/5 w-[400px] h-[400px] bg-[#3B82F6] opacity-[0.07] rounded-full blur-[80px] pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#06B6D4] opacity-[0.03] rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 py-20 relative z-10 w-full">
      <div class="flex flex-col lg:flex-row items-center gap-16">

        <!-- Text block -->
        <div class="flex-1 text-center lg:text-left">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-[#818CF8] mb-6 px-3 py-1.5 rounded-full border border-[#1E3A6E] bg-[#0D1535]/80 backdrop-blur-sm animate-in">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 pulse-dot"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            AWS User Group · Morelos, México
          </div>

          <!-- Headline -->
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] mb-6 animate-in delay-100">
            Aprende, comparte
            <br />
            <span class="gradient-text-aurora">y crece en la nube</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-lg md:text-xl text-slate-400 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed animate-in delay-200">
            La comunidad AWS de Morelos. Conocimiento real de builders reales: blog técnico, glosario y eventos presenciales.
          </p>

          <!-- CTA buttons -->
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start animate-in delay-300">
            <a
              href="/registro"
              class="group relative inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#7C3AED] hover:bg-[#8B5CF6] text-white font-semibold transition-all duration-200 hover:scale-[1.02] glow-purple"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
              Únete a la comunidad
            </a>
            <a
              href="/blog"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-[#1E3A6E] text-slate-300 hover:border-[#818CF8] hover:text-white hover:bg-[#0D1535]/50 font-semibold transition-all duration-200"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              Ver el Blog
            </a>
          </div>
        </div>

        <!-- Logo / visual -->
        <div class="flex-shrink-0 animate-in delay-200">
          <div class="relative w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96">
            <!-- Rotating ring -->
            <div class="absolute inset-0 rounded-full border border-[#818CF8]/15 animate-spin" style="animation-duration:20s;"></div>
            <div class="absolute inset-4 rounded-full border border-[#7C3AED]/15 animate-spin" style="animation-duration:15s;animation-direction:reverse;"></div>

            <!-- Glow -->
            <div class="absolute inset-8 bg-[#7C3AED] opacity-[0.15] rounded-full blur-2xl"></div>

            <!-- Logo -->
            <img
              src="/assets/logo.png"
              alt="AWS UG Morelos"
              class="absolute inset-0 m-auto w-48 h-48 md:w-64 md:h-64 object-contain drop-shadow-2xl float"
            />
          </div>
        </div>
      </div>

      <!-- Stats bar -->
      <div class="mt-16 grid grid-cols-3 gap-3 max-w-md mx-auto lg:mx-0 animate-in delay-300">
        {[
          { value: '100+', label: 'Miembros' },
          { value: '6+',   label: 'Eventos realizados' },
          { value: '1 año', label: 'De comunidad activa' },
        ].map(stat => (
          <div class="glass-card rounded-xl p-4 text-center lg:text-left shimmer">
            <p class="text-2xl font-bold gradient-text">{stat.value}</p>
            <p class="text-xs text-slate-500 mt-0.5 leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT — BENTO GRID ═════════════════════════════════ -->
  <section id="about" class="py-24 relative">
    <div class="absolute inset-0 dot-pattern opacity-40"></div>
    <div class="max-w-6xl mx-auto px-4 relative z-10">

      <div class="text-center mb-14">
        <span class="tag bg-[#111F4A] text-[#818CF8] border border-[#1E3A6E] mb-3">La comunidad</span>
        <h2 class="text-4xl font-bold text-white mb-3">¿Quiénes somos?</h2>
        <p class="text-slate-400 max-w-2xl mx-auto leading-relaxed">
          AWS User Group Morelos es una comunidad independiente de profesionales, estudiantes y entusiastas de la nube en el estado de Morelos, México.
        </p>
      </div>

      <!-- Bento grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 auto-rows-fr">

        <!-- Card grande: Meetups -->
        <div class="lg:col-span-2 glass-card rounded-2xl p-8 card-hover border border-[#1E3A6E] group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-200">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Meetups & Eventos</h3>
          <p class="text-slate-400 leading-relaxed">Charlas técnicas presenciales y virtuales con expertos de la comunidad y AWS. Desde casos de uso reales hasta demos en vivo de los servicios más demandados.</p>
          <div class="mt-6 flex items-center gap-2 text-sm text-[#818CF8] font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Próximos eventos en LinkedIn
          </div>
        </div>

        <!-- Card: Blog -->
        <div class="glass-card rounded-2xl p-7 card-hover border border-[#1E3A6E] group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#06B6D4] to-[#3B82F6] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-200">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Blog de Miembros</h3>
          <p class="text-slate-400 text-sm leading-relaxed">Cualquier miembro puede publicar posts técnicos, tutoriales y casos de uso reales vía Pull Request en GitHub.</p>
          <a href="/blog" class="mt-5 inline-flex items-center gap-1.5 text-sm text-[#06B6D4] font-medium hover:gap-2.5 transition-all duration-200">
            Ir al blog
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Card: Glosario -->
        <div class="glass-card rounded-2xl p-7 card-hover border border-[#1E3A6E] group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#7C3AED] to-[#EC4899] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-200">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Glosario AWS</h3>
          <p class="text-slate-400 text-sm leading-relaxed">+100 términos y servicios de AWS explicados en español. Desde fundamentos hasta IA y DevOps.</p>
          <a href="/glossary" class="mt-5 inline-flex items-center gap-1.5 text-sm text-[#A78BFA] font-medium hover:gap-2.5 transition-all duration-200">
            Ver glosario
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

        <!-- Card: comunidad stat -->
        <div class="lg:col-span-2 glass-card rounded-2xl p-7 card-hover border border-[#1E3A6E] bg-gradient-to-br from-[#0D1535] to-[#111F4A]">
          <p class="text-sm text-slate-500 font-medium uppercase tracking-widest mb-3">Nuestra comunidad</p>
          <p class="text-slate-300 text-base leading-relaxed max-w-lg">
            Organizamos meetups, talleres y charlas técnicas. Cualquiera puede contribuir al blog o al glosario y compartir lo que ha aprendido trabajando con AWS.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {['AWS Cloud', 'Serverless', 'DevOps', 'Machine Learning', 'Seguridad', 'Comunidad'].map(tag => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-[#060D24] text-slate-400 border border-[#1E3A6E]">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LATEST BLOG POSTS ════════════════════════════════════ -->
  {latestPosts.length > 0 && (
    <section class="py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-[#0D1535]/40"></div>
      <div class="max-w-6xl mx-auto px-4 relative z-10">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="tag bg-[#111F4A] text-[#06B6D4] border border-[#1E3A6E] mb-3 block w-fit">Blog técnico</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white">Últimos posts</h2>
            <p class="text-slate-500 mt-1">Conocimiento compartido por la comunidad</p>
          </div>
          <a
            href="/blog"
            class="hidden sm:inline-flex items-center gap-1.5 text-sm text-[#818CF8] hover:text-white font-medium transition-colors group"
          >
            Ver todos
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {latestPosts.map(post => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ GLOSSARY PREVIEW ══════════════════════════════════════ -->
  {featuredTerms.length > 0 && (
    <section class="py-24 relative">
      <div class="absolute inset-0 grid-pattern opacity-30"></div>
      <div class="absolute inset-0 aurora"></div>
      <div class="max-w-6xl mx-auto px-4 relative z-10">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="tag bg-[#111F4A] text-[#A78BFA] border border-[#1E3A6E] mb-3 block w-fit">Glosario AWS</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white">Términos populares</h2>
            <p class="text-slate-500 mt-1">Explicados en español por la comunidad</p>
          </div>
          <a
            href="/glossary"
            class="hidden sm:inline-flex items-center gap-1.5 text-sm text-[#818CF8] hover:text-white font-medium transition-colors group"
          >
            Ver glosario completo
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {featuredTerms.map(term => <GlossaryCard term={term} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ CTA ═══════════════════════════════════════════════════ -->
  <section class="py-24 relative overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#7C3AED]/10 via-transparent to-[#3B82F6]/10"></div>
    <div class="absolute inset-0 dot-pattern opacity-30"></div>

    <!-- Gradient border top -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#7C3AED]/60 to-transparent"></div>

    <div class="max-w-2xl mx-auto px-4 text-center relative z-10">
      <!-- Icon -->
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center mx-auto mb-6 glow-purple-lg">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>

      <h2 class="text-4xl font-bold text-white mb-4">¿Listo para unirte?</h2>
      <p class="text-slate-400 text-lg mb-8 leading-relaxed">
        Forma parte de la comunidad AWS más activa de Morelos. Aprende con nosotros, presenta en meetups y contribuye al blog.
      </p>
      <a
        href="/registro"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-[#7C3AED] hover:bg-[#8B5CF6] text-white font-bold text-lg transition-all duration-200 hover:scale-[1.02] glow-purple"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        Regístrate gratis
      </a>
      <p class="text-slate-600 text-sm mt-4">Sin spam. Tus datos solo se usan para comunicaciones de AWS UG Morelos.</p>
    </div>
  </section>

</BaseLayout>
