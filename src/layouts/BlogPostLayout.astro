---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, summary, author, authorRole, avatar, date, tags } = post.data;

const formattedDate = new Intl.DateTimeFormat('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---

<BaseLayout title={title} description={summary}>
  <article class="max-w-3xl mx-auto px-4 py-16">

    <!-- Back link -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors mb-8 group"
    >
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Volver al Blog
    </a>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-5">
      {tags.map((tag) => (
        <span class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-[#111F4A] text-[#818CF8] border border-[#1E3A6E] font-medium">
          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
          </svg>
          {tag}
        </span>
      ))}
    </div>

    <!-- Title -->
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">{title}</h1>
    <p class="text-slate-400 text-lg mb-8 leading-relaxed">{summary}</p>

    <!-- Author -->
    <div class="flex items-center gap-4 mb-10 pb-8 border-b border-[#1E3A6E]">
      {avatar ? (
        <img src={avatar} alt={author} class="w-11 h-11 rounded-full object-cover ring-2 ring-[#1E3A6E]" />
      ) : (
        <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center text-white font-bold text-lg ring-2 ring-[#1E3A6E]">
          {author.charAt(0).toUpperCase()}
        </div>
      )}
      <div>
        <p class="text-white font-semibold">{author}</p>
        <p class="text-sm text-slate-500">{authorRole ?? 'Miembro AWS UG Morelos'} · {formattedDate}</p>
      </div>
    </div>

    <!-- Content -->
    <div class="prose prose-invert prose-purple max-w-none
      prose-headings:font-bold prose-headings:text-white prose-headings:tracking-tight
      prose-h2:text-2xl prose-h3:text-xl
      prose-p:text-slate-300 prose-p:leading-relaxed
      prose-a:text-[#818CF8] prose-a:no-underline hover:prose-a:underline
      prose-code:text-[#818CF8] prose-code:bg-[#0D1535] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-[#0D1535] prose-pre:border prose-pre:border-[#1E3A6E] prose-pre:rounded-xl
      prose-blockquote:border-l-[#7C3AED] prose-blockquote:text-slate-400 prose-blockquote:bg-[#0D1535]/50 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:not-italic
      prose-strong:text-white prose-strong:font-semibold
      prose-li:text-slate-300 prose-li:marker:text-[#818CF8]
      prose-hr:border-[#1E3A6E]
      prose-img:rounded-xl prose-img:border prose-img:border-[#1E3A6E]">
      <slot />
    </div>

    <!-- Footer -->
    <div class="mt-14 pt-8 border-t border-[#1E3A6E] flex items-center justify-between gap-4 flex-wrap">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Todos los posts
      </a>
      <a
        href="/registro"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#7C3AED] hover:bg-[#8B5CF6] text-white text-sm font-semibold transition-all glow-purple"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
        Únete a la comunidad
      </a>
    </div>
  </article>
</BaseLayout>
