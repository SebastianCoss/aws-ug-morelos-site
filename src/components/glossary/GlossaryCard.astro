---

<a
  href={`/glossary/${term.id}`}
  class="group block p-5 rounded-xl bg-[#0D1535] border border-[#1E3A6E] card-hover h-full"
>
  <!-- Category badge with icon -->
  <div class="flex items-center justify-between mb-3">
    <span class={`inline-flex items-center gap-1.5 text-xs font-semibold px-2 py-1 rounded-lg border ${cfg.bg} ${cfg.text} ${cfg.border}`}>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cfg.iconPath}/>
      </svg>
      {category}
    </span>
    {acronym && (
      <span class="text-xs font-mono text-slate-600 bg-[#060D24] px-2 py-0.5 rounded border border-[#1E3A6E]">{acronym}</span>
    )}
  </div>

  <!-- Title -->
  <h3 class="text-white font-bold text-base group-hover:text-[#818CF8] transition-colors duration-200 mb-2">
    {title}
  </h3>

  <!-- Description -->
  <p class="text-slate-500 text-sm line-clamp-2 leading-relaxed">{description}</p>

  <!-- Read more hint -->
  <div class="mt-3 flex items-center gap-1 text-xs text-slate-600 group-hover:text-[#818CF8] transition-colors duration-200">
    <span>Ver más</span>
    <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </div>
</a>
