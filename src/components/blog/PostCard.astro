---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, summary, author, date, tags, avatar } = post.data;

const formattedDate = new Intl.DateTimeFormat('es-MX', {
  year: 'numeric', month: 'short', day: 'numeric',
}).format(date);

// Estimate read time (avg 200 words/min)
const wordCount = summary.split(' ').length * 8; // rough estimate
const readTime = Math.max(1, Math.round(wordCount / 200));
---

<article class="group relative flex flex-col h-full rounded-xl bg-[#0D1535] border border-[#1E3A6E] card-hover overflow-hidden">
  <!-- Top accent bar -->
  <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#7C3AED] via-[#818CF8] to-[#3B82F6] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.slice(0, 2).map(tag => (
        <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-[#0D1535] text-[#818CF8] border border-[#1E3A6E] font-medium">
          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
          </svg>
          {tag}
        </span>
      ))}
      <span class="ml-auto text-xs text-slate-600 flex items-center gap-1">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {readTime} min
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-white font-bold text-lg leading-snug mb-2 group-hover:text-[#818CF8] transition-colors duration-200 flex-none">
      <a href={`/blog/${post.id}`} class="stretched-link focus:outline-none focus-visible:outline-none">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-slate-500 text-sm leading-relaxed flex-1 line-clamp-3 mb-5">{summary}</p>

    <!-- Author -->
    <div class="flex items-center gap-3 pt-4 border-t border-[#1E3A6E]/60">
      {avatar ? (
        <img src={avatar} alt={author} class="w-8 h-8 rounded-full object-cover ring-1 ring-[#1E3A6E]" />
      ) : (
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#7C3AED] to-[#3B82F6] flex items-center justify-center text-white text-xs font-bold ring-1 ring-[#1E3A6E]">
          {author.charAt(0).toUpperCase()}
        </div>
      )}
      <div class="min-w-0 flex-1">
        <p class="text-white text-xs font-semibold truncate">{author}</p>
        <p class="text-slate-600 text-xs">{formattedDate}</p>
      </div>
      <svg class="w-4 h-4 text-slate-600 group-hover:text-[#818CF8] group-hover:translate-x-0.5 transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</article>
