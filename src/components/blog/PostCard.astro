---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, summary, author, date, tags, avatar } = post.data;

const formattedDate = new Intl.DateTimeFormat('es-MX', {
  year: 'numeric', month: 'short', day: 'numeric',
}).format(date);
---

<article class="group p-6 rounded-xl bg-[#0D1535] border border-[#1E3A6E] hover:border-[#818CF8] transition-all hover:-translate-y-1 flex flex-col h-full">
  <!-- Tags -->
  <div class="flex flex-wrap gap-1.5 mb-3">
    {tags.slice(0, 2).map(tag => (
      <span class="text-xs px-2 py-0.5 rounded-full bg-[#111F4A] text-[#818CF8] border border-[#1E3A6E]">
        #{tag}
      </span>
    ))}
  </div>

  <!-- Title -->
  <h3 class="text-white font-bold text-lg leading-snug mb-2 group-hover:text-[#818CF8] transition-colors">
    <a href={`/blog/${post.id}`} class="stretched-link">{title}</a>
  </h3>

  <!-- Summary -->
  <p class="text-slate-400 text-sm leading-relaxed flex-1 mb-4 line-clamp-3">{summary}</p>

  <!-- Author -->
  <div class="flex items-center gap-2 pt-4 border-t border-[#1E3A6E]">
    {avatar ? (
      <img src={avatar} alt={author} class="w-7 h-7 rounded-full object-cover" />
    ) : (
      <div class="w-7 h-7 rounded-full bg-[#6B3FA0] flex items-center justify-center text-white text-xs font-bold">
        {author.charAt(0)}
      </div>
    )}
    <div>
      <p class="text-white text-xs font-medium">{author}</p>
      <p class="text-slate-500 text-xs">{formattedDate}</p>
    </div>
  </div>
</article>
