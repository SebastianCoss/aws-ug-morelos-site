---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src="/assets/logo.png" alt="AWS UG Morelos" class="w-8 h-8 object-contain" />
          <span class="text-white font-bold">AWS UG Morelos</span>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Comunidad de builders en Morelos, México. Aprendemos, compartimos y crecemos juntos en AWS.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Explora</h3>
        <ul class="space-y-2">
          {[
            { href: '/blog', label: 'Blog' },
            { href: '/glossary', label: 'Glosario AWS' },
            { href: '/registro', label: 'Únete a la comunidad' },
            { href: '/#about', label: 'Sobre nosotros' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-muted)] hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Síguenos</h3>
        <div class="flex gap-3">
          <a
            href="https://www.meetup.com/aws-morelos"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-white hover:border-[var(--color-aws-neon)] transition-colors"
            aria-label="Meetup"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.24 12.058a.915.915 0 0 1-.149.312l-.009.012a.806.806 0 0 1-.65.312h-.034l-.022-.001a.806.806 0 0 1-.633-.312l-.009-.012a.915.915 0 0 1-.149-.312l-.832-3.33-1.53 4.455a.915.915 0 0 1-.149.312l-.009.012a.806.806 0 0 1-.65.312h-.034l-.022-.001a.806.806 0 0 1-.633-.312l-.009-.012a.915.915 0 0 1-.149-.312L12 8.892l-.832 3.166a.915.915 0 0 1-.149.312l-.009.012a.806.806 0 0 1-.65.312H10.326l-.022-.001a.806.806 0 0 1-.633-.312l-.009-.012a.915.915 0 0 1-.149-.312L8 8.2l-1.33 3.858a.915.915 0 0 1-.149.312l-.009.012a.806.806 0 0 1-.65.312H5.828l-.022-.001a.806.806 0 0 1-.633-.312l-.009-.012a.915.915 0 0 1-.149-.312L4 8l-.015.058H2V20h20V8.058h-2.76z"/>
            </svg>
          </a>
          <a
            href="https://twitter.com/awsugmorelos"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-white hover:border-[var(--color-aws-neon)] transition-colors"
            aria-label="Twitter / X"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/company/aws-ug-morelos"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-white hover:border-[var(--color-aws-neon)] transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--color-border)] flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-[var(--color-text-muted)]">
        © {year} AWS User Group Morelos. Comunidad independiente, no afiliada oficialmente con Amazon Web Services.
      </p>
      <p class="text-xs text-[var(--color-text-muted)]">
        Hecho con ❤️ en Morelos, México
      </p>
    </div>
  </div>
</footer>
