---
const year = new Date().getFullYear();
---

<footer class="relative border-t border-[var(--color-border)] overflow-hidden">
  <div class="absolute inset-0 bg-[var(--color-surface)]/60"></div>
  <div class="absolute inset-0 grid-pattern opacity-20"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#818CF8]/20 to-transparent"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">

      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="relative">
            <div class="absolute inset-0 bg-[#7C3AED] opacity-25 rounded-full blur-md"></div>
            <img src="/assets/logo.png" alt="AWS UG Morelos" class="relative w-9 h-9 object-contain" />
          </div>
          <div>
            <p class="text-white font-bold text-sm leading-tight">AWS UG Morelos</p>
            <p class="text-[#818CF8] text-xs leading-tight">Community</p>
          </div>
        </div>
        <p class="text-sm text-slate-500 leading-relaxed max-w-xs">
          Comunidad de builders en Morelos, México. Aprendemos, compartimos y crecemos juntos en la nube.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-xs uppercase tracking-widest text-slate-400">Explora</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/blog',      label: 'Blog técnico',          icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
            { href: '/glossary',  label: 'Glosario AWS',          icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
            { href: '/registro',  label: 'Únete a la comunidad',  icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z' },
            { href: '/#about',    label: 'Sobre nosotros',        icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
          ].map(link => (
            <li>
              <a href={link.href} class="flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors group">
                <svg class="w-3.5 h-3.5 text-slate-700 group-hover:text-[#818CF8] transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon}/>
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-xs uppercase tracking-widest text-slate-400">Síguenos</h3>
        <div class="flex gap-3 mb-5">
          <a
            href="https://www.linkedin.com/company/aws-ug-morelos/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-slate-500 hover:text-white hover:border-[#0A66C2] hover:bg-[#0A66C2]/10 transition-all duration-200"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/aws_ug_morelos"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-border)] flex items-center justify-center text-slate-500 hover:text-white hover:border-[#E1306C] hover:bg-[#E1306C]/10 transition-all duration-200"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Forma parte de nuestra comunidad en redes sociales y mantente al tanto de los próximos eventos.
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-[var(--color-border)]/50 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-xs text-slate-600 text-center sm:text-left">
        © {year} AWS User Group Morelos · Comunidad independiente, no afiliada con Amazon Web Services.
      </p>
      <p class="text-xs text-slate-700 flex items-center gap-1">
        Hecho con
        <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
        </svg>
        en Morelos, México
      </p>
    </div>
  </div>
</footer>
