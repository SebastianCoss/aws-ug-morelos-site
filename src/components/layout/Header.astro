---
const navLinks = [
  { href: '/#about', label: 'Nosotros' },
  { href: '/blog', label: 'Blog' },
  { href: '/glossary', label: 'Glosario' },
  { href: '/registro', label: 'Únete', highlight: true },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 glass border-b border-[var(--color-border)]">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/assets/logo.png"
        alt="AWS UG Morelos"
        class="w-12 h-12 object-contain group-hover:scale-105 transition-transform"
      />
      <div class="hidden sm:block">
        <p class="text-white font-bold text-sm leading-tight">AWS UG</p>
        <p class="text-[var(--color-aws-neon)] text-xs font-medium leading-tight">Morelos</p>
      </div>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          {link.highlight ? (
            <a
              href={link.href}
              class="ml-2 px-4 py-2 rounded-lg bg-[var(--color-aws-purple)] hover:bg-purple-600 text-white text-sm font-medium transition-colors glow-purple"
            >
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                currentPath.startsWith(link.href.replace('/#', '/'))
                  ? 'text-white bg-[var(--color-surface-2)]'
                  : 'text-[var(--color-text-muted)] hover:text-white hover:bg-[var(--color-surface)]'
              }`}
            >
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-[var(--color-text-muted)] hover:text-white p-2"
      aria-label="Abrir menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] px-4 pb-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block py-3 text-sm font-medium border-b border-[var(--color-border)] last:border-0 ${
          link.highlight ? 'text-[var(--color-aws-neon)]' : 'text-[var(--color-text-muted)] hover:text-white'
        }`}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
